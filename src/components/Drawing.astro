---
/* Gold line drawings for the fleet families that have no usable photo (from the earlier roster cards). */
interface Props { kind: 'rough' | 'crawler' | 'tractor'; class?: string }
const { kind, class: cls } = Astro.props;
---
{kind === 'rough' && (
  <div class:list={["spec", cls]} role="img" aria-label='Line drawing: Kobelco RK rough-terrain crane'><svg class="spec__svg" viewBox="0 0 360 230" focusable="false" aria-hidden="true"><g class="spec__draw" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" class="spec__faint" d="M6 206H354"/><path pathLength="1" class="spec__faint" d="M14 8v10M9 13h10M346 8v10M341 13h10M14 212v10M9 217h10M346 212v10M341 217h10"/><path pathLength="1" d="M60 178V150H296V178Z"/><path pathLength="1" d="M66 150V120H106L116 150"/><path pathLength="1" class="spec__faint" d="M72 126H102V144H72Z"/><path pathLength="1" class="spec__faint" d="M60 170H36V202M296 170H322V202M28 202H44M314 202H330"/><circle pathLength="1" cx="104" cy="182" r="22"/><circle pathLength="1" cx="104" cy="182" r="8"/><circle pathLength="1" cx="252" cy="182" r="22"/><circle pathLength="1" cx="252" cy="182" r="8"/><path pathLength="1" d="M150 150V140H238V150"/><path pathLength="1" d="M238 140H272V122H240Z"/><path pathLength="1" d="M234 132L82 30L74 42L226 144Z"/><path pathLength="1" class="spec__faint" d="M186 100L178 112M138 68L130 80"/><path pathLength="1" d="M206 150L182 112"/><path pathLength="1" class="spec__faint" d="M78 36V118"/><path pathLength="1" d="M73 118h10v7h-10z"/><path pathLength="1" d="M78 125v6a6 6 0 1 1-6 6"/></g></svg></div>
)}
{kind === 'crawler' && (
  <div class:list={["spec", cls]} role="img" aria-label='Line drawing: lattice-boom crawler crane'><svg class="spec__svg" viewBox="0 0 360 230" focusable="false" aria-hidden="true"><g class="spec__draw" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" class="spec__faint" d="M6 206H354"/><path pathLength="1" class="spec__faint" d="M14 8v10M9 13h10M346 8v10M341 13h10M14 212v10M9 217h10M346 212v10M341 217h10"/><path pathLength="1" d="M84 202H262A14 14 0 0 0 262 174H84A14 14 0 0 0 84 202Z"/><circle pathLength="1" class="spec__faint" cx="96" cy="188" r="6"/><circle pathLength="1" class="spec__faint" cx="126" cy="188" r="6"/><circle pathLength="1" class="spec__faint" cx="156" cy="188" r="6"/><circle pathLength="1" class="spec__faint" cx="186" cy="188" r="6"/><circle pathLength="1" class="spec__faint" cx="216" cy="188" r="6"/><circle pathLength="1" class="spec__faint" cx="246" cy="188" r="6"/><path pathLength="1" d="M106 174V160H244V174"/><path pathLength="1" d="M146 160V128H252V160"/><path pathLength="1" d="M118 160V136H146"/><path pathLength="1" class="spec__faint" d="M124 140H142V156H124Z"/><path pathLength="1" d="M252 154H276V130H252"/><path pathLength="1" d="M236 128L248 98L260 128"/><path pathLength="1" d="M182.4 119.9L78.4 9.9M173.6 128.1L69.6 18.1"/><path pathLength="1" class="spec__faint" d="M182.4 119.9L165.0 119.0L165.0 101.5L147.6 100.6L147.7 83.2L130.3 82.3L130.4 64.9L113.0 64.0L113.0 46.5L95.6 45.6L95.7 28.2L78.3 27.3L78.4 9.9"/><path pathLength="1" class="spec__faint" d="M76 16L248 98"/><path pathLength="1" class="spec__faint" d="M74 18V140"/><path pathLength="1" d="M69 140h10v7h-10z"/><path pathLength="1" d="M74 147v6a6 6 0 1 1-6 6"/></g></svg></div>
)}
{kind === 'tractor' && (
  <div class:list={["spec", cls]} role="img" aria-label='Line drawing: tractor head'><svg class="spec__svg" viewBox="0 0 360 230" focusable="false" aria-hidden="true"><g class="spec__draw" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" class="spec__faint" d="M6 206H354"/><path pathLength="1" class="spec__faint" d="M14 8v10M9 13h10M346 8v10M341 13h10M14 212v10M9 217h10M346 212v10M341 217h10"/><path pathLength="1" d="M40 166H322M40 174H322"/><path pathLength="1" d="M46 166V84Q46 72 58 72H118L130 92V166"/><path pathLength="1" class="spec__faint" d="M54 90H114V122H54Z"/><path pathLength="1" class="spec__faint" d="M88 128V162"/><path pathLength="1" d="M38 166H62V180H38Z"/><path pathLength="1" class="spec__faint" d="M48 136H56M48 144H56M48 152H56"/><path pathLength="1" d="M136 166V58M142 58V166M134 58H144"/><path pathLength="1" d="M150 166V144H204V166"/><path pathLength="1" d="M240 160H294V152H240Z"/><path pathLength="1" class="spec__faint" d="M262 152V146H272V152"/><circle pathLength="1" cx="92" cy="188" r="20"/><circle pathLength="1" cx="92" cy="188" r="7"/><circle pathLength="1" cx="246" cy="188" r="20"/><circle pathLength="1" cx="246" cy="188" r="7"/><circle pathLength="1" cx="296" cy="188" r="20"/><circle pathLength="1" cx="296" cy="188" r="7"/><path pathLength="1" class="spec__faint" d="M64 166A28 28 0 0 1 120 166M218 166A28 28 0 0 1 324 166"/></g></svg></div>
