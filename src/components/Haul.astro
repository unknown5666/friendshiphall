---
/* Interlude after the fleet: our own night time-lapse of a crane being rigged down for a lowbed move, full bleed.
 * Plays muted on a loop once it nears the viewport (core.js, Lazy time-lapse); the corner button pauses it. */
---
<section class="haul" id="night-move" aria-label="Time-lapse: an FHS crane rigged down overnight for a lowbed move" data-folio="Interlude">
  <div class="haul__frame" data-reveal data-timelapse>
    <video data-lazy-video muted loop playsinline preload="none" width="1280" height="720"
           data-poster="/assets/video/fhs-night-haul-poster.webp"
           aria-label="Time-lapse of an FHS all-terrain crane rigged down overnight in the city">
      <source data-src="/assets/video/fhs-night-haul.mp4" type="video/mp4">
    </video>
    <span class="haul__rec" aria-hidden="true"><i></i>Time-lapse · Night move</span>
    <button type="button" class="haul__toggle" data-timelapse-toggle aria-pressed="false">
      <svg class="haul__icon haul__icon--play" viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true"><path d="M8.5 5.2v13.6L19.2 12z" fill="currentColor"/></svg>
      <svg class="haul__icon haul__icon--pause" viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true"><path d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z" fill="currentColor"/></svg>
    </button>
  </div>
  <div class="haul__cap wrap" data-reveal="up">
    <p class="haul__quote">Struck by night. <em>Moving by morning.</em></p>
    <p class="haul__meta"><span class="haul__tag">Heavy transport</span><span>Rig-down, lowbed, permits and escort: one crew, one night</span></p>
  </div>
</section>
