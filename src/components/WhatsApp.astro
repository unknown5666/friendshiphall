---
/* Floating WhatsApp: one button, a two-line chooser (src/scripts/core.js §8, src/styles/overlays.css §2). */
---
<div class="wa" data-wa>
  <span class="wa__glow" aria-hidden="true"></span>
  <button class="wa__fab" type="button" popovertarget="wa-panel" data-wa-fab>
    <svg class="wa__icon wa__icon--wa" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
    <svg class="wa__icon wa__icon--x" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
    <span class="wa__tip">WhatsApp us</span>
  </button>
  <div class="wa__panel" id="wa-panel" popover role="dialog" aria-labelledby="wa-title" data-wa-panel>
    <div class="wa__head">
      <p class="wa__kicker">WhatsApp · 24/7</p>
      <p class="wa__title" id="wa-title">Who would you like to talk to?</p>
    </div>
    <ul class="wa__list">
      <li>
        <a class="wa__line" href="https://wa.me/971529026103?text=Hello%20Bashir%2C%20I%27m%20enquiring%20about%20crane%20rental." target="_blank" rel="noopener">
          <span class="wa__avatar wa__avatar--b" aria-hidden="true">B</span>
          <span class="wa__who"><span class="wa__name">Bashir</span><span class="wa__role">Chief Operations Officer</span></span>
          <span class="wa__go" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></span><span class="sr-only"> (opens WhatsApp)</span>
        </a>
      </li>
      <li>
        <a class="wa__line" href="https://wa.me/971528335333?text=Hello%20Saeed%2C%20I%27m%20enquiring%20about%20crane%20rental." target="_blank" rel="noopener">
          <span class="wa__avatar wa__avatar--b" aria-hidden="true">S</span>
          <span class="wa__who"><span class="wa__name">Saeed</span><span class="wa__role">Chief Executive Officer</span></span>
          <span class="wa__go" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></span><span class="sr-only"> (opens WhatsApp)</span>
        </a>
      </li>
      <li>
        <a class="wa__line" href="https://wa.me/971506176471?text=Hello%20Abid%2C%20I%27m%20enquiring%20about%20crane%20rental." target="_blank" rel="noopener">
          <span class="wa__avatar wa__avatar--b" aria-hidden="true">A</span>
          <span class="wa__who"><span class="wa__name">Abid</span><span class="wa__role">Manager</span></span>
          <span class="wa__go" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></span><span class="sr-only"> (opens WhatsApp)</span>
        </a>
      </li>
    </ul>
    <p class="wa__foot">Opens a chat in WhatsApp</p>
  </div>
</div>
