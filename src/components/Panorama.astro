---
import Photo from './Photo.astro';
---
<section class="panorama" id="tandem" aria-label="Tandem lift of a steel pipeline truss" data-folio="Interlude">
  <div class="panorama__frame">
    <Photo name="tandem-bridge-panorama" class="panorama__img" sizes="(min-width: 960px) 115vw, 135vw" w={1280} h={545} alt="Two cranes lifting a long steel pipeline truss in tandem" />
  </div>
  <div class="panorama__cap wrap" data-reveal="up">
    <p class="panorama__quote">Two cranes. <em>One pipeline span.</em></p>
    <p class="panorama__meta"><span class="panorama__tag">Tandem lift</span><span>A steel pipeline truss, set in one pick</span></p>
  </div>
</section>
