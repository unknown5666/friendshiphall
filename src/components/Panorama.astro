---
import Photo from './Photo.astro';
---
<section class="panorama" id="tandem" aria-label="Two cranes and a steel arch on a road site" data-folio="Interlude">
  <div class="panorama__frame">
    <Photo name="tandem-bridge-panorama" class="panorama__img" sizes="(min-width: 960px) 115vw, 135vw" w={1280} h={545} alt="Two cranes, each rigged to a steel arched truss, on a road construction site" />
  </div>
  <div class="panorama__cap wrap" data-reveal="up">
    <p class="panorama__quote">Planned on paper. <em>Proven on site.</em></p>
    <p class="panorama__meta"><span class="panorama__tag">On site</span><span>United Arab Emirates</span></p>
  </div>
</section>
