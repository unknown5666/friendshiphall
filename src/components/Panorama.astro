---
import Photo from './Photo.astro';
---
<section class="panorama" id="tandem" aria-label="Tandem lift of a steel pedestrian bridge" data-folio="Interlude">
  <div class="panorama__frame">
    <Photo name="tandem-bridge-panorama" class="panorama__img" sizes="(min-width: 960px) 115vw, 135vw" w={1280} h={545} alt="Two cranes performing a tandem lift of a steel pedestrian bridge" />
  </div>
  <div class="panorama__cap wrap" data-reveal="up">
    <p class="panorama__quote">Two cranes. One bridge. <em>Zero margin.</em></p>
    <p class="panorama__meta"><span class="panorama__tag">Tandem lift</span><span>A steel pedestrian bridge</span></p>
  </div>
</section>
