---
import Photo from './Photo.astro';
---
<section class="panorama" id="tandem" aria-label="Installing an overhead crossing at an oil facility" data-folio="Interlude">
  <div class="panorama__frame">
    <Photo name="tandem-bridge-panorama" class="panorama__img" sizes="(min-width: 960px) 115vw, 135vw" w={1280} h={545} alt="Two cranes rigged to a steel overhead crossing being installed at an oil facility" />
  </div>
  <div class="panorama__cap wrap" data-reveal="up">
    <p class="panorama__quote">Two cranes. <em>One overhead crossing.</em></p>
    <p class="panorama__meta"><span class="panorama__tag">Overhead crossing</span><span>Oil facility installation</span></p>
  </div>
</section>
