---
import Photo from './Photo.astro';

/* The HSE system, run as a pre-lift checklist: each row ticks itself off as it scrolls in, and the stamp lands after
 * the last one. The copy lives here; keep it to things FHS does on every job. */
const practices = [
  {
    name: 'Toolbox talk,',
    em: 'every shift.',
    desc: 'Before a crane leaves the yard, the crew is briefed on the day’s lifts, the hazards on site and who does what. Attendance is recorded.',
  },
  {
    name: 'Every lift,',
    em: 'planned.',
    desc: 'Lift plans and engineered rigging studies fix the crane, configuration, radius, ground bearing and rigging before we arrive. Critical lifts are checked by an Appointed Person.',
  },
  {
    name: 'Assessed,',
    em: 'then permitted.',
    desc: 'A method statement and risk assessment for each job, and on site we work inside the client’s permit-to-work system. No permit, no lift.',
  },
  {
    name: 'Full PPE,',
    em: 'no exceptions.',
    desc: 'Hard hat, hi-vis, coveralls and safety boots for everyone in the yard and on site, and every helmet carries its site-induction stickers.',
  },
  {
    name: 'Drilled for',
    em: 'the worst day.',
    desc: 'Evacuation drills to marked assembly points, with a headcount, so everyone knows where to go and the supervisor knows who is missing.',
  },
  {
    name: 'Equipment,',
    em: 'checked daily.',
    desc: 'Operators run pre-use checks every day. Cranes, tyres, rigging and lifting accessories are maintained in our own workshop and carry current third-party inspection certificates.',
  },
];

/* On the yard: the wall of crew photos. `sizes` is widened by each slot's crop factor (the photos are 2.16:1). */
const shots = [
  { name: 'hse-yard-lineup', sizes: '(min-width: 960px) 56vw, 92vw', w: 1280, h: 591, alt: 'A briefing to a line of FHS crew in front of the parked mobile cranes', cap: 'A briefing in front of the parked cranes.' },
  { name: 'hse-toolbox-talk', sizes: '(min-width: 960px) 46vw, 100vw', w: 1280, h: 591, alt: 'A briefing beside a building wall, with a forklift and a mobile crane in the yard behind the crew', cap: 'A briefing by the yard building.' },
  { name: 'hse-crew-vests', sizes: '(min-width: 960px) 56vw, 92vw', w: 1280, h: 591, alt: 'Rows of FHS crew from behind, FHE logos on their hi-vis vests and coveralls', cap: 'FHE on every back: vests and coveralls, row after row.' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="section safety" id="safety" aria-labelledby="safety-title" data-folio="VI · Safety &amp; HSE">
  <div class="wrap">
    <header class="chapter-head grid">
      <p class="chapter-mark" data-reveal>
        <span class="chapter-mark__no">VI</span>
        <span class="chapter-mark__rule" aria-hidden="true"></span>
        <span class="chapter-mark__label">Safety &amp; HSE</span>
        <span class="chapter-mark__of" aria-hidden="true">VI / VII</span>
      </p>
      <h2 class="chapter-title" id="safety-title" data-reveal="up">Safety first. <em>Then the lift.</em></h2>
      <p class="chapter-intro" data-reveal="up" data-d="2">Every crew is briefed, equipped and drilled before a crane leaves the yard, and every lift is planned before it is made.</p>
    </header>

    <!-- The opener: full bleed, opens like a viewfinder and pulls back as it scrolls -->
    <figure class="hse-lead" data-reveal>
      <div class="plate__frame hse-lead__frame">
        <Photo name="hse-yard-huddle" class="hse-lead__img" sizes="(min-width: 960px) 100vw, (min-width: 600px) 162vw, 270vw" w={1280} h={591} alt="FHS crew in red coveralls and FHE hi-vis vests gathered in a circle for a toolbox talk in front of three mobile cranes" />
        <span class="hse-lead__corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <p class="hse-lead__osd" aria-hidden="true"><span class="hse-lead__rec"></span>Safety briefing · The yard</p>
      </div>
      <p class="hse-lead__title" data-reveal="lines">
        <span class="line"><span>Briefed.</span></span>
        <span class="line"><span><em>Equipped.</em></span></span>
        <span class="line"><span>Drilled.</span></span>
      </p>
      <figcaption class="plate__cap hse-lead__cap"><span>A safety briefing in the crane yard, the crew in one circle.</span></figcaption>
    </figure>

    <!-- The HSE system: a pre-lift checklist -->
    <div class="hse">
      <div class="hse__head grid">
        <p class="eyebrow hse__eyebrow" data-reveal="up">The HSE system</p>
        <p class="hse__statement" data-reveal="up" data-d="1" data-lit>Nobody lifts until <em>everyone knows the plan.</em></p>
      </div>
      <ol class="hse__list">
        {practices.map((p, i) => (
          <li class="hse__item" data-reveal="check">
            <span class="hse__no" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="hse__name">{p.name} <em>{p.em}</em></h3>
            <p class="hse__desc">{p.desc}</p>
            <span class="hse__check" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4.5 12.6l4.7 4.7L19.6 6.9" /></svg></span>
          </li>
        ))}
      </ol>
      <div class="hse__clear" data-reveal="stamp">
        <p class="stamp">
          <span class="stamp__ink">
            <img class="stamp__mark" src="/assets/brand/fhs-mark.svg" alt="" width="64" height="64" loading="lazy" decoding="async" />
            <span class="stamp__text">
              <span class="stamp__main">Cleared to lift</span>
              <span class="stamp__sub">Pre-lift check · {practices.length} of {practices.length}</span>
            </span>
          </span>
        </p>
      </div>
    </div>
  </div>

  <!-- Full-bleed type band: two lines of the creed sliding past each other as the page scrolls -->
  <div class="hse-band" aria-hidden="true">
    <p class="hse-band__row hse-band__row--a"><span>Safety first — Then the lift — Safety first — Then the lift — Safety first — Then the lift —</span></p>
    <p class="hse-band__row hse-band__row--b"><span>Briefed · Equipped · Drilled · Checked · Briefed · Equipped · Drilled · Checked · Briefed · Equipped ·</span></p>
  </div>

  <div class="wrap">
    <div class="hse-wall">
      <p class="eyebrow hse-wall__label" data-reveal="up">On the yard <span class="hse-wall__count">{pad(shots.length)} frames</span></p>
      {shots.map((s, i) => (
        <figure class={`plate hse-shot hse-shot--${i + 1}`} data-reveal data-d={i % 2 ? '2' : undefined}>
          <div class="plate__frame">
            <Photo name={s.name} sizes={s.sizes} w={s.w} h={s.h} alt={s.alt} />
          </div>
          <figcaption class="plate__cap"><span class="hse-shot__no" aria-hidden="true">{pad(i + 1)} / {pad(shots.length)}</span><span>{s.cap}</span></figcaption>
        </figure>
      ))}
    </div>

    <div class="safety__spread grid">
      <figure class="plate safety__fig" data-reveal>
        <div class="plate__frame">
          <Photo name="crew-ppe-terex" sizes="(min-width: 960px) 56vw, 92vw" w={1280} h={813} alt="Three FHS crew in hard hats and hi-vis vests in front of a Terex FRIENDSHIP crane" />
        </div>
        <figcaption class="plate__cap"><span>Three FHS crew in front of a Terex FRIENDSHIP crane.</span></figcaption>
      </figure>
      <div class="safety__text" data-reveal="stagger">
        <figure class="plate safety__inset">
          <div class="plate__frame">
            <Photo name="superlift-uae-flag" sizes="(min-width: 960px) 30vw, 92vw" w={1280} h={1707} alt="Heavy crane with a luffing jib beside a building draped with the UAE flag" />
          </div>
          <figcaption class="plate__cap"><span>Lifting beside the flag, in the Emirates since 1986.</span></figcaption>
        </figure>
        <p>Every lift starts with a plan. Our quality and occupational health &amp; safety management systems are certified to ISO 9001:2015 and ISO 45001:2018.</p>
        <p>Trained operators and lifting supervisors are provided with our equipment, and our site surveys come with engineered rigging studies for maximum safety and efficiency.</p>
      </div>
    </div>

    <ul class="certs" data-reveal="stagger">
      <li class="cert">
        <p class="cert__std">ISO 9001:2015</p>
        <p class="cert__name">Quality management</p>
        <dl class="cert__facts">
          <div><dt>Certificate</dt><dd>SD-26048/01</dd></div>
          <div><dt>First certified</dt><dd><time datetime="2017-03-26">26 Mar 2017</time></dd></div>
        </dl>
        <p class="cert__scope">Scope: General Transportation and Renting of Mobile Cranes &amp; Lifting Equipment.</p>
      </li>
      <li class="cert cert--hse">
        <p class="cert__std">ISO 45001:2018</p>
        <p class="cert__name">Occupational health &amp; safety</p>
        <p class="cert__scope">The standard the HSE system above is certified to.</p>
      </li>
    </ul>
  </div>
</section>
