---
/* The mark intro (src/scripts/mark.js) and the page furniture that sits over everything: the cable rail and grain.
   The stage gets a gold copy of the header mark; a canvas for sparks is added by script. */
---
<div class="preloader" data-preloader="mark" aria-hidden="true">
  <div class="preloader__backdrop"></div>
  <div class="preloader__hud">
    <span class="preloader__frame"></span>
    <span class="preloader__axis preloader__axis--x"></span>
    <span class="preloader__axis preloader__axis--y"></span>
    <p class="preloader__corner preloader__corner--tl">Mobile cranes 25–700 T</p>
    <p class="preloader__corner preloader__corner--tr">UAE <span data-uae-clock="hm">00:00</span> GST</p>
    <p class="preloader__corner preloader__corner--bl">Since 1986 · 40 years</p>
    <p class="preloader__corner preloader__corner--br">Support 24/7</p>
    <div class="mark-caption">
      <p class="mark-caption__name">Friendship Hall</p>
      <p class="mark-caption__line">Heavy lifting · United Arab Emirates</p>
    </div>
    <p class="mark-load">Load <b data-mark-load>25</b> T</p>
  </div>
  <div class="mark-stage" data-mark-stage></div>
</div>

<div class="rail" data-rail aria-hidden="true">
  <span class="rail__line"></span>
  <span class="rail__hook"></span>
  <span class="rail__label" data-rail-label>Prologue</span>
</div>

<div class="grain" aria-hidden="true"></div>
