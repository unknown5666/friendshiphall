---
import Photo from './Photo.astro';
---
<section class="section works" id="works" aria-labelledby="works-title" data-folio="IV · Selected works">
  <div class="wrap">
    <header class="chapter-head grid">
      <p class="chapter-mark" data-reveal>
        <span class="chapter-mark__no">IV</span>
        <span class="chapter-mark__rule" aria-hidden="true"></span>
        <span class="chapter-mark__label">Selected works</span>
        <span class="chapter-mark__of" aria-hidden="true">IV / VII</span>
      </p>
      <h2 class="chapter-title" id="works-title" data-reveal="up">Selected <em>works.</em></h2>
      <p class="chapter-intro" data-reveal="up" data-d="2">Photographed on site, across the Emirates.</p>
    </header>

    <div class="works__grid">
      <figure class="work work--1" data-reveal>
        <div class="plate__frame">
          <Photo name="tensile-roof-tandem" sizes="(min-width: 960px) 55vw, 92vw" w={1280} h={960} alt="Four mobile cranes in a coordinated multi-crane lift of a tensile fabric roof" />
        </div>
        <figcaption class="work__cap"><span>Four mobile cranes in a coordinated lift of a tensile fabric roof.</span></figcaption>
      </figure>

      <figure class="work work--2" data-reveal data-d="2">
        <div class="plate__frame">
          <Photo name="port-vessel-dusk" sizes="(min-width: 960px) 30vw, 72vw" w={1280} h={1707} alt="Red luffing-jib crane lifting a vessel at a port at dusk" />
        </div>
        <figcaption class="work__cap"><span>A red luffing-jib crane lifting a vessel at a port, at dusk.</span></figcaption>
      </figure>

      <figure class="work work--3" data-reveal>
        <div class="plate__frame">
          <Photo name="night-dhow-lift" sizes="(min-width: 960px) 46vw, 92vw" w={1280} h={960} alt="Night lift of a traditional wooden dhow with spreader bars under floodlights" />
        </div>
        <figcaption class="work__cap"><span>A traditional wooden dhow lifted on spreader bars, at night under floodlights.</span></figcaption>
      </figure>

      <figure class="work work--4" data-reveal data-d="2">
        <div class="plate__frame">
          <Photo name="excavator-rooftop-lift" sizes="(min-width: 960px) 26vw, 66vw" w={1280} h={1707} alt="FHE crane lifting an excavator up the face of a building" />
        </div>
        <figcaption class="work__cap"><span>An excavator lifted up the face of a building.</span></figcaption>
      </figure>

      <figure class="work work--5" data-reveal>
        <div class="plate__frame">
          <Photo name="yacht-spreader-lift" sizes="(min-width: 960px) 30vw, 72vw" w={1280} h={1707} alt="Yellow mobile crane lifting a yacht hull with a spreader frame" />
        </div>
        <figcaption class="work__cap"><span>A yacht hull raised on a spreader frame.</span></figcaption>
      </figure>

      <figure class="work work--6" data-reveal data-d="2">
        <div class="plate__frame">
          <Photo name="luffing-civic-building" sizes="(min-width: 960px) 38vw, 82vw" w={1280} h={1707} alt="Yellow luffing crane lifting steelwork beside a civic building" />
        </div>
        <figcaption class="work__cap"><span>A yellow luffing crane lifting steelwork beside a civic building.</span></figcaption>
      </figure>
      <figure class="work work--7" data-reveal>
        <div class="plate__frame">
          <Photo name="tower-crane-dismantle" sizes="(min-width: 960px) 22vw, 70vw" w={1280} h={1707} alt="Telescopic mobile crane dismantling a tower crane on a city site" />
        </div>
        <figcaption class="work__cap"><span>A tower crane taken down by a telescopic mobile crane, mid-city.</span></figcaption>
      </figure>
      <figure class="work work--8" data-reveal data-d="2">
        <div class="plate__frame">
          <Photo name="piling-rig-excavation" sizes="(min-width: 960px) 55vw, 92vw" w={1280} h={960} alt="Mobile crane lowering a piling rig into a deep excavation between city towers" />
        </div>
        <figcaption class="work__cap"><span>A piling rig lowered into a deep excavation between towers.</span></figcaption>
      </figure>
      <figure class="work work--9" data-reveal>
        <div class="plate__frame">
          <Photo name="luffing-jib-towercrane" sizes="(min-width: 960px) 55vw, 92vw" w={1280} h={960} alt="Yellow luffing-jib crane assembling a tower crane beside a concrete frame" />
        </div>
        <figcaption class="work__cap"><span>A luffing-jib crane assembling a tower crane beside the frame.</span></figcaption>
      </figure>
      <figure class="work work--10" data-reveal data-d="2">
        <div class="plate__frame">
          <Photo name="luffing-building-day" sizes="(min-width: 960px) 30vw, 72vw" w={1280} h={1707} alt="Yellow luffing crane alongside a curved mid-rise building" />
        </div>
        <figcaption class="work__cap"><span>A yellow luffing crane alongside a curved mid-rise.</span></figcaption>
      </figure>
      <figure class="work work--11" data-reveal>
        <div class="plate__frame">
          <Photo name="yellow-crane-towercrane" sizes="(min-width: 960px) 30vw, 72vw" w={1280} h={1707} alt="Yellow mobile crane working beside a tower crane on a tree-lined site" />
        </div>
        <figcaption class="work__cap"><span>Working beside a tower crane on a tree-lined site.</span></figcaption>
      </figure>
      <figure class="work work--12" data-reveal data-d="2">
        <div class="plate__frame">
          <Photo name="transmission-tower-b" sizes="(min-width: 960px) 30vw, 72vw" w={1280} h={1707} alt="Heavy crane counterweight and luffing jib between lattice transmission towers" />
        </div>
        <figcaption class="work__cap"><span>Counterweight and luffing jib between transmission towers.</span></figcaption>
      </figure>
      <figure class="work work--13" data-reveal>
        <div class="plate__frame">
          <Photo name="fisheye-highrise-luffing" sizes="(min-width: 960px) 30vw, 72vw" w={1280} h={1707} alt="Yellow luffing crane reaching up a high-rise facade" />
        </div>
        <figcaption class="work__cap"><span>A luffing crane reaching up a high-rise facade.</span></figcaption>
      </figure>

      <figure class="work work--14" data-reveal>
        <div class="plate__frame">
          <Photo name="heavy-crane-superlift-night" sizes="(min-width: 960px) 30vw, 72vw" w={1280} h={1707} alt="FHE heavy crane with superlift counterweight working at night" />
        </div>
        <figcaption class="work__cap"><span>A heavy crane on superlift counterweight, working through the night.</span></figcaption>
      </figure>

      <figure class="work work--15" data-reveal data-d="2">
        <div class="plate__frame">
          <Photo name="crawler-crane-coast" sizes="(min-width: 960px) 55vw, 92vw" w={1280} h={960} alt="White lattice-boom crawler crane working on a coastal site" />
        </div>
        <figcaption class="work__cap"><span>A lattice-boom crawler crane working on a coastal site.</span></figcaption>
      </figure>
    </div>
  </div>
</section>
