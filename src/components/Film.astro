---
---
<section class="section film-section" id="timelapse" aria-labelledby="film-title" data-folio="I · The work in time">
  <div class="wrap">
    <header class="chapter-head grid">
      <p class="chapter-mark" data-reveal>
        <span class="chapter-mark__no">I</span>
        <span class="chapter-mark__rule" aria-hidden="true"></span>
        <span class="chapter-mark__label">The work in time</span>
        <span class="chapter-mark__of" aria-hidden="true">I / VII</span>
      </p>
      <h2 class="chapter-title" id="film-title" data-reveal="up">The work, <em>in time.</em></h2>
      <p class="chapter-intro" data-reveal="up" data-d="2">A reel of FHS heavy lifts across the Emirates, one after another.</p>
    </header>

    <figure class="film" data-reveal>
      <div class="film__bar film__bar--top" aria-hidden="true"><span>Friendship Hall · Heavy lifts</span><span>Time-lapse</span></div>
      <div class="film__frame">
        <div class="timelapse" data-timelapse>
          <video data-lazy-video muted loop playsinline preload="none" width="1280" height="720"
                 data-poster="/assets/video/crane-timelapse-poster-1280.webp"
                 aria-label="Time-lapse of FHS heavy lifts">
            <source data-src="/assets/video/crane-timelapse.mp4" type="video/mp4">
          </video>
          <button type="button" class="timelapse__toggle" data-timelapse-toggle aria-pressed="false">
            <span class="timelapse__ring" aria-hidden="true">
              <svg class="timelapse__icon timelapse__icon--play" viewBox="0 0 24 24" width="26" height="26" focusable="false"><path d="M8.5 5.2v13.6L19.2 12z" fill="currentColor"/></svg>
              <svg class="timelapse__icon timelapse__icon--pause" viewBox="0 0 24 24" width="26" height="26" focusable="false"><path d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z" fill="currentColor"/></svg>
            </span>
            <span class="timelapse__state"><span class="timelapse__state-play">Play the reel</span><span class="timelapse__state-pause">Pause</span></span>
          </button>
        </div>
      </div>
      <div class="film__bar film__bar--bottom" aria-hidden="true"><span>UAE</span><span>24/7</span></div>
      <figcaption class="film__cap"><span>Time-lapse</span><span>Girder lifts, tandem lifts and everything between</span></figcaption>
    </figure>
  </div>
</section>
