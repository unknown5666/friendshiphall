---
/* Contact us: the lift slate. Opened by any [data-enquire] link (its value, if any, names the sector; data-cap presets
 * the crane size). Without JS those links fall back to #contact. The slate mirrors the form for sighted users; it is
 * aria-hidden, the form carries everything. Behaviour: src/scripts/site.js §3. Styles: src/styles/site.css §23. */
import Photo from './Photo.astro';
---
<dialog class="brief" id="brief" aria-labelledby="brief-title" data-brief>
  <button class="brief__close" type="button" data-brief-close>
    <span>Close</span>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  </button>
  <div class="brief__stage" data-brief-stage>
    <div class="brief__scene">
      <Photo name="night-luffing-city" class="brief__photo" sizes="(min-width: 960px) 42vw, 100vw" w={1280} h={960} alt="" />
      <div class="brief__slot" data-slate-home>
        <div class="slate" data-slate aria-hidden="true">
          <div class="slate__sticks">
            <span class="slate__stick slate__stick--top" data-slate-stick></span>
            <span class="slate__stick slate__stick--base"></span>
            <span class="slate__hinge"></span>
          </div>
          <div class="slate__body">
            <p class="slate__head"><span>Friendship Hall</span><span>Lift brief</span></p>
            <div class="slate__cap">
              <p class="slate__k">Crane</p>
              <p class="slate__t"><span data-slate="t">100</span><small data-slate="unit">T</small></p>
              <p class="slate__class" data-slate="class">Precast, steel erection, tower-crane assembly</p>
            </div>
            <dl class="slate__grid">
              <div><dt>Service</dt><dd data-slate="service">Crane hire</dd></div>
              <div><dt>Site</dt><dd data-slate="site" class="is-empty">—</dd></div>
              <div><dt>From</dt><dd data-slate="date" class="is-empty">—</dd></div>
              <div><dt>Client</dt><dd data-slate="client" class="is-empty">—</dd></div>
            </dl>
            <p class="slate__foot"><span>UAE <span data-uae-clock="hm">00:00</span> GST</span><span>Line open 24/7</span></p>
          </div>
        </div>
      </div>
      <p class="brief__scene-cap">Your brief, as our team will read it.</p>
    </div>

    <div class="brief__panel">
      <header class="brief__head">
        <p class="eyebrow" data-brief-kicker>Contact us · 24/7</p>
        <h2 class="brief__title" id="brief-title" tabindex="-1" autofocus>Tell us about <em>the lift.</em></h2>
        <p class="brief__lede">Fill in what you know. It reaches our sales team on WhatsApp or by email, and an engineer sizes the crane with you.</p>
      </header>

      <form class="brief__form" data-brief-form novalidate>
        <input type="hidden" name="sector" value="" data-brief-sector>
        <fieldset class="brief__step">
          <legend class="brief__legend"><span class="brief__no" aria-hidden="true">01</span>The job</legend>
          <fieldset class="field">
            <legend class="field__label">Service</legend>
            <div class="chips">
              <label class="chip"><input type="radio" name="service" value="Crane hire" checked><span>Crane hire</span></label>
              <label class="chip"><input type="radio" name="service" value="Heavy transport"><span>Heavy transport</span></label>
              <label class="chip"><input type="radio" name="service" value="Site survey &amp; rigging study"><span>Site survey &amp; rigging study</span></label>
            </div>
          </fieldset>
          <div class="field field--dial" data-dial>
            <div class="dial__head">
              <label class="field__label" for="bf-cap">Crane capacity</label>
              <output class="dial__out" for="bf-cap" aria-hidden="true" data-cap-out>100 T</output>
            </div>
            <input class="dial" id="bf-cap" name="capacity" type="range" min="0" max="1000" step="1" value="416" aria-describedby="bf-cap-class" data-cap>
            <ol class="dial__ticks" aria-hidden="true">
              <li style="--x:0">25</li><li style="--x:.208">50</li><li style="--x:.416">100</li><li style="--x:.623">200</li>
              <li style="--x:.746">300</li><li style="--x:.899">500</li><li style="--x:1">700</li>
            </ol>
            <p class="field__hint" id="bf-cap-class" data-cap-class>Typical work: precast, steel erection, tower-crane assembly.</p>
            <label class="check"><input type="checkbox" name="advise" data-cap-advise><span class="check__box" aria-hidden="true"></span><span>Not sure. Advise me on the crane.</span></label>
          </div>
        </fieldset>

        <fieldset class="brief__step">
          <legend class="brief__legend"><span class="brief__no" aria-hidden="true">02</span>The site</legend>
          <div class="field-row">
            <div class="field">
              <label class="field__label" for="bf-site">Emirate</label>
              <div class="select">
                <select class="input" id="bf-site" name="site" data-bind="site">
                  <option value="">Choose an emirate</option>
                  <option>Abu Dhabi</option><option>Dubai</option><option>Sharjah</option><option>Ajman</option>
                  <option>Umm Al Quwain</option><option>Ras Al Khaimah</option><option>Fujairah</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label class="field__label" for="bf-date">Start date</label>
              <input class="input" id="bf-date" name="date" type="date" data-bind="date">
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="bf-notes">About the lift <span class="field__opt">Optional</span></label>
            <textarea class="input input--area" id="bf-notes" name="notes" rows="3" placeholder="Load weight, lift radius, site access, how long you need the crane"></textarea>
          </div>
        </fieldset>

        <fieldset class="brief__step">
          <legend class="brief__legend"><span class="brief__no" aria-hidden="true">03</span>You</legend>
          <div class="field-row">
            <div class="field">
              <label class="field__label" for="bf-name">Name</label>
              <input class="input" id="bf-name" name="name" type="text" autocomplete="name" required aria-describedby="bf-name-err" data-bind="client">
              <p class="field__error" id="bf-name-err" data-error-for="bf-name"></p>
            </div>
            <div class="field">
              <label class="field__label" for="bf-company">Company <span class="field__opt">Optional</span></label>
              <input class="input" id="bf-company" name="company" type="text" autocomplete="organization" data-bind="client">
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label class="field__label" for="bf-phone">Phone</label>
              <input class="input" id="bf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+971" required aria-describedby="bf-phone-err">
              <p class="field__error" id="bf-phone-err" data-error-for="bf-phone"></p>
            </div>
            <div class="field">
              <label class="field__label" for="bf-email">Email <span class="field__opt">Optional</span></label>
              <input class="input" id="bf-email" name="email" type="email" autocomplete="email" aria-describedby="bf-email-err">
              <p class="field__error" id="bf-email-err" data-error-for="bf-email"></p>
            </div>
          </div>
        </fieldset>

        <div class="brief__dock" data-slate-dock></div>

        <div class="brief__actions">
          <button class="btn btn--solid" type="submit" value="whatsapp">Send on WhatsApp
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="btn" type="submit" value="email">Send by email</button>
        </div>
        <p class="brief__alt">Need a crane today? Call <a href="tel:+97124485660">+971 2 448 5660</a>, any hour.</p>
      </form>

      <div class="brief__done" data-brief-done hidden>
        <p class="eyebrow">Brief ready</p>
        <h3 class="brief__done-title" tabindex="-1" data-done-title>WhatsApp is open with your brief.</h3>
        <p class="brief__done-text"><span data-done-text>Press send in WhatsApp and our sales team will reply.</span> If nothing opened, <a href="#" target="_blank" rel="noopener" data-done-link>open it here</a>.</p>
        <div class="brief__actions">
          <button class="btn" type="button" data-brief-edit>Edit the brief</button>
          <button class="btn btn--solid" type="button" data-brief-close>Close</button>
        </div>
      </div>
    </div>

  </div>
</dialog>
