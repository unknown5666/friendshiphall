---
import Mark from './Mark.astro';
---
<header class="site-header">
  <div class="bar">
    <a class="brand" href="#top" aria-label="Friendship Hall — home">
      <span class="brand__emblem" data-dock-target>
<Mark />
      </span>
      <span class="brand__word"><span>Friendship</span> <span>Hall</span></span>
    </a>
    <div class="bar__right">
      <nav class="nav" id="site-nav" aria-label="Primary">
        <ul class="nav__list">
          <li class="nav__extra"><a href="#timelapse"><span class="nav__no" aria-hidden="true">I</span>The work in time</a></li>
          <li><a href="#services"><span class="nav__no" aria-hidden="true">II</span>Services</a></li>
          <li><a href="#fleet"><span class="nav__no" aria-hidden="true">III</span>Fleet</a></li>
          <li><a href="#works"><span class="nav__no" aria-hidden="true">IV</span>Projects</a></li>
          <li class="nav__extra"><a href="#industries"><span class="nav__no" aria-hidden="true">V</span>Industries</a></li>
          <li class="nav__extra"><a href="#safety"><span class="nav__no" aria-hidden="true">VI</span>Safety</a></li>
          <li class="nav__extra"><a href="#contact"><span class="nav__no" aria-hidden="true">VII</span>Contact</a></li>
        </ul>
        <div class="nav__foot">
          <p class="nav__foot-label">Any hour, anywhere in the UAE</p>
          <a class="btn btn--solid" href="#contact" data-enquire>Contact us</a>
          <a class="btn" href="tel:+97124485660">Call +971 2 448 5660</a>
          <a class="btn btn--ghost" href="https://wa.me/971529026105">WhatsApp Sales</a>
        </div>
      </nav>
      <a class="bar__call" href="tel:+97124485660" aria-label="Call Friendship Hall, 24/7: +971 2 448 5660">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M6.6 3.5h2.6l1.4 4-2 1.4a12 12 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        <span class="bar__call-num">+971 2 448 5660</span>
      </a>
      <a class="btn btn--bar" href="#contact" data-enquire>Contact us</a>
      <button class="nav-toggle" type="button" data-nav-toggle aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
        <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>
